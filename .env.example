# Django core
DJANGO_SECRET_KEY=change-me-to-a-secure-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.onrender.com,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.onrender.com,http://127.0.0.1,http://localhost

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require

# Email
# For dev without SMTP: DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Contact form (Web3Forms)
WEB3FORMS_ACCESS_KEY=

# Google OAuth
DJANGO_GOOGLE_OAUTH_CLIENT_ID=
DJANGO_GOOGLE_OAUTH_CLIENT_SECRET=

